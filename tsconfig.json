{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "lib": [
      "ES2022"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "baseUrl": ".",
    "paths": {
      "@rotty3000/config-node": [
        "src/index.ts"
      ]
    }
  },
  "include": [
    "src/",
    "test/",
    "examples/"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
